{
  "name": "sensoutrack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node server/index.js --dev",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "build:cloud": "node scripts/check-cloud-env.mjs && vite build --mode cloud --outDir dist-cloud",
    "build:meta": "node scripts/check-cloud-env.mjs && node scripts/build-survey-synthesis.mjs --check && vite build --mode meta --outDir dist-meta",
    "deploy": "npm run build:cloud && npx wrangler deploy",
    "survey:dev": "node survey-dashboard/server.mjs --dev",
    "survey:build": "node scripts/build-survey-synthesis.mjs --check && node survey-dashboard/build.mjs",
    "survey:publish-snapshot": "node scripts/export-public-survey.mjs",
    "survey:start": "node survey-dashboard/server.mjs",
    "survey:test": "node --test survey-dashboard/*.test.mjs",
    "survey:synthesis:build": "node scripts/build-survey-synthesis.mjs",
    "survey:synthesis:check": "node scripts/build-survey-synthesis.mjs --check",
    "survey:synthesis:prepare": "node scripts/build-survey-synthesis.mjs --prepare"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.1.0"
  }
}
