# Copy to .env.cloud.local. These values are PUBLIC browser configuration.
# Never put a Supabase secret/service_role key in a VITE_ variable.
# Without these variables, npm run dev uses the local Node/SQLite API.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Public Turnstile site key. Its secret belongs ONLY in Supabase Auth CAPTCHA settings.
VITE_TURNSTILE_SITE_KEY=
# Optional public AdSense publisher ID, exactly as shown in your AdSense account.
# Adds ownership verification only; does not load ad scripts or enable ads.
VITE_ADSENSE_PUBLISHER_ID=
# Keep false until Google approves the site and CMP, privacy notices and the
# public-only CSP/referrer changes have been reviewed and tested. Account builds
# never import advertising. This flag alone is not a complete live activation.
VITE_ADSENSE_ACTIVE=false
# Separate switch: CMP can be tested with ad requests permanently paused.
# Keep false until Google's site approval and live consent/withdrawal checks pass.
VITE_ADSENSE_SERVING=false
